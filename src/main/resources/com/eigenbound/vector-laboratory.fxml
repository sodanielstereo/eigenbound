<?xml version="1.0" encoding="UTF-8"?>

<?import com.eigenbound.presentation.canvas.VectorCanvas?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eigenbound.presentation.laboratory.VectorLaboratoryController"
            prefWidth="1180.0"
            prefHeight="720.0"
            stylesheets="@eigenbound.css"
            styleClass="root-pane">
  <top>
    <VBox spacing="5.0"
                  styleClass="header">
      <padding>
        <Insets top="18.0"
                                right="24.0"
                                bottom="18.0"
                                left="24.0"/>
      </padding>
      <Label text="EIGENBOUND"
                         styleClass="game-title"/>
      <Label text="Valle de los Vectores · Estabiliza el portal mediante combinaciones lineales"
                         styleClass="game-subtitle"/>
    </VBox>
  </top>

  <center>
    <StackPane styleClass="canvas-container">
      <padding>
        <Insets top="18.0"
                                right="18.0"
                                bottom="18.0"
                                left="18.0"/>
      </padding>
      <VectorCanvas fx:id="vectorCanvas"/>
    </StackPane>
  </center>

  <right>
    <VBox prefWidth="330.0"
                  minWidth="300.0"
                  spacing="14.0"
                  styleClass="control-panel">
      <padding>
        <Insets top="20.0"
                                right="20.0"
                                bottom="20.0"
                                left="20.0"/>
      </padding>
      <Label text="EXPEDICIÓN"
                         styleClass="section-title"/>
      <HBox spacing="8.0">
        <Button text="−"
                                onAction="#onDecreaseDifficulty"
                                styleClass="small-button"/>
        <Label fx:id="difficultyLabel"
                               text="Dificultad: 1"
                               styleClass="information-label"/>
        <Button text="+"
                                onAction="#onIncreaseDifficulty"
                                styleClass="small-button"/>
      </HBox>
      <Label fx:id="seedLabel"
                         text="Semilla:"
                         styleClass="secondary-label"/>
      <VBox spacing="5.0"
                        styleClass="information-card">
        <Label fx:id="targetLabel"
                               text="Objetivo:"
                               styleClass="target-label"/>
        <Label fx:id="positionLabel"
                               text="Posición:"
                               styleClass="position-label"/>
        <Label fx:id="stepsLabel"
                               text="Movimientos restantes:"
                               styleClass="information-label"/>
      </VBox>
      <Label text="VECTORES DISPONIBLES"
                         styleClass="section-title"/>
      <VBox fx:id="movementButtonContainer"
                        spacing="8.0"/>
      <Label fx:id="selectedMovesLabel"
                         text="Secuencia: ninguna"
                         wrapText="true"
                         styleClass="sequence-label"/>
      <HBox spacing="8.0">
        <Button fx:id="undoButton"
                                text="Deshacer"
                                onAction="#onUndo"
                                maxWidth="Infinity"
                                HBox.hgrow="ALWAYS"
                                styleClass="secondary-button"/>
        <Button text="Reiniciar"
                                onAction="#onReset"
                                maxWidth="Infinity"
                                HBox.hgrow="ALWAYS"
                                styleClass="secondary-button"/>
      </HBox>
      <Button text="COMPROBAR"
                          onAction="#onCheck"
                          maxWidth="Infinity"
                          styleClass="primary-button"/>
      <Button text="NUEVO DESAFÍO"
                          onAction="#onNewChallenge"
                          maxWidth="Infinity"
                          styleClass="secondary-button"/>
      <Label fx:id="statusLabel"
                         text="Combina los vectores para alcanzar el portal."
                         wrapText="true"
                         styleClass="status-neutral"/>
    </VBox>
  </right>
</BorderPane>
